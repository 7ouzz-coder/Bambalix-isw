generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  category  String
  code      String?  @unique
  mode      String   @default("UNIT")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  @@index([category, name])
}

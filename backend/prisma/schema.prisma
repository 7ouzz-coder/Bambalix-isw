generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  category  String
  code      String?  @unique
  mode      String   @default("UNIT")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  @@index([category, name])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String
  rut       String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  @@index([name])
}
